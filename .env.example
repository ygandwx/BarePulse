# Copy to .env. Generate unique local values; never commit .env.
POSTGRES_PASSWORD=replace-with-random-hex-password
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-unique-12-to-72-byte-password
BASE_URL=http://127.0.0.1:8080
SECURE_COOKIES=false
POSTGRES_PORT=5432
APP_PORT=8080
ALLOW_REAL_DEVICES=false
ALLOW_DEVICE_WRITES=false
# Native execution (Compose sets its own DB URL):
DATABASE_URL=postgres://barepulse:replace-with-random-hex-password@127.0.0.1:5432/barepulse?sslmode=disable
TEST_DATABASE_URL=postgres://barepulse:replace-with-random-hex-password@127.0.0.1:5432/barepulse_test?sslmode=disable
MEDIA_DIR=work/media
MAX_MEDIA_BYTES=2000000000
# Integration and device secrets are server-side environment values, referenced by name.
# BAREPULSE_WHMCSTEST_SECRET=<at-least-32-random-characters>
